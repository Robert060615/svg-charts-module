@startuml lib_class_diagram

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam monochrome true
skinparam defaultFontSize 12
skinparam nodesep 70
skinparam ranksep 60

hide empty members
hide circles

abstract class Chart {
    ~{static}FONT_FAMILY: String = "sans-serif"
    -{static}TITLE_BASELINE: int = 24
    -{static}TITLE_FONT_SIZE: int = 16
    -{static}CATEGORY_LABEL_OFFSET: int = 20
    -options: ChartOptions
    -plotArea: PlotArea
    -labelStyle: LabelStyle
    -title: String = ""
    -labels: List<String>
    -values: List<Double>

    ~Chart(ChartOptions options)
    +setTitle(String title): void
    +setLabels(List<String> labels): void
    +setValues(List<Double> values): void
    +toSvg(): String
    ~{abstract}axisMin(): double
    ~{abstract}axisMax(): double
    ~{abstract}horizontalPositionOf(int index): double
    ~{abstract}drawData(LinearScale verticalScale): SvgElement
    ~minValue(): double
    ~maxValue(): double
    ~verticalPositionOf(int index, LinearScale verticalScale): double
    ~getOptions(): ChartOptions
    ~getPlotArea(): PlotArea
    ~getTitle(): String
    ~getLabels(): List<String>
    ~getValues(): List<Double>
    -copyWithoutNulls<T>(List<T> items, String itemName): List<T>
    -requireFiniteValues(List<Double> values): void
    -requireRenderableData(): void
    -requireValues(): void
    -requireOneLabelPerValue(): void
    -hasLabels(): boolean
    -hasOneLabelPerValue(): boolean
    -createValueAxis(): ValueAxis
    -createRoot(): SvgElement
    -createBackground(): SvgElement
    -createHeading(): SvgElement
    -createCategoryLabels(): SvgElement
    -createCategoryLabel(int index): SvgElement
}

class BarChart {
    -{static}BAR_WIDTH_RATIO: double = 0.8

    +BarChart()
    +BarChart(ChartOptions options)
    ~axisMin(): double
    ~axisMax(): double
    ~horizontalPositionOf(int index): double
    ~drawData(LinearScale verticalScale): SvgElement
    -createBar(int index, LinearScale verticalScale): SvgElement
    -categoryWidth(): double
}

class LineChart {
    -{static}LINE_WIDTH: int = 2
    -{static}POINT_RADIUS: int = 4
    -numberFormatter: NumberFormatter

    +LineChart()
    +LineChart(ChartOptions options)
    ~axisMin(): double
    ~axisMax(): double
    ~horizontalPositionOf(int index): double
    ~drawData(LinearScale verticalScale): SvgElement
    -createLine(LinearScale verticalScale): SvgElement
    -createPathData(LinearScale verticalScale): String
    -createPoint(int index, LinearScale verticalScale): SvgElement
}

class ChartOptions {
    -{static}MINIMUM_SIZE: int = 100
    -{static}SHORT_HEX_LENGTH: int = 4
    -{static}LONG_HEX_LENGTH: int = 7
    -{static}HEX_RADIX: int = 16
    -width: int = 600
    -height: int = 400
    -color: String = "#1f77b4"

    +ChartOptions()
    +setWidth(int width): void
    +setHeight(int height): void
    +setColor(String color): void
    ~getWidth(): int
    ~getHeight(): int
    ~getColor(): String
    -requireMinimumSize(String dimension, int size): int
    -isHexColor(String color): boolean
    -hasHexColorLength(String color): boolean
    -hasOnlyHexDigitsAfterHash(String color): boolean
}

class ChartDataException {
    -{static}serialVersionUID: long = 1

    ~ChartDataException(String message)
}

class IllegalArgumentException

class PlotArea {
    -{static}MARGIN_TOP: int = 40
    -{static}MARGIN_RIGHT: int = 20
    -{static}MARGIN_BOTTOM: int = 40
    -{static}MARGIN_LEFT: int = 50
    -options: ChartOptions

    ~PlotArea(ChartOptions options)
    ~left(): double
    ~right(): double
    ~top(): double
    ~bottom(): double
    ~width(): double
}

class ValueAxis {
    -{static}TARGET_TICK_COUNT: int = 5
    -{static}TICK_LABEL_GAP: int = 8
    -{static}GRID_COLOR: String = "#e0e0e0"
    -plotArea: PlotArea
    -ticks: List<Double>
    -scale: LinearScale
    -labelStyle: LabelStyle

    ~ValueAxis(Interval dataRange, PlotArea plotArea)
    ~scale(): LinearScale
    ~toSvgElement(): SvgElement
    -createScale(): LinearScale
    -createGridLine(double y): SvgElement
    -createTickLabel(double tick, double y): SvgElement
    -formatTick(double tick): String
}

class LabelStyle {
    -{static}FONT_SIZE: int = 12

    ~createGroup(String textAnchor): SvgElement
}

class TickGenerator {
    -{static}TOLERANCE: double = 1e-9
    -targetTickCount: int

    ~TickGenerator(int targetTickCount)
    ~generateTicks(double min, double max): List<Double>
    ~calculateStep(double min, double max): double
    -requireMinNotGreaterThanMax(double min, double max): void
    -generateTicksForRange(double min, double max): List<Double>
    -roundDownToStep(double value, double step): double
    -roundUpToStep(double value, double step): double
    -generateTicksForSingleValue(double value): List<Double>
    -roundToNiceNumber(double normalizedStep): double
    -roundToStepPrecision(double value, double step): double
}

class LinearScale {
    -domain: Interval
    -pixels: Interval

    ~LinearScale(Interval domain, Interval pixels)
    ~toPixel(double value): double
}

class Interval {
    -start: double
    -end: double

    ~Interval(double start, double end)
    ~start(): double
    ~end(): double
    ~length(): double
    ~middle(): double
    ~fractionOf(double value): double
    ~valueAt(double fraction): double
}

class SvgElement {
    -tagName: String
    -attributes: Map<String, String>
    -children: List<SvgElement>
    -escaper: XmlEscaper
    -numberFormatter: NumberFormatter
    -text: String = ""

    ~SvgElement(String tagName)
    ~setAttribute(String name, String value): SvgElement
    ~setAttribute(String name, double value): SvgElement
    ~setText(String text): SvgElement
    ~addChild(SvgElement child): SvgElement
    +toString(): String
    -appendTo(StringBuilder xml): void
    -appendAttributes(StringBuilder xml): void
    -hasContent(): boolean
    -appendContent(StringBuilder xml): void
}

class XmlEscaper {
    ~escape(String text): String
    -toEntity(char character): String
}

class NumberFormatter {
    ~format(double value): String
    -removeTrailingZeros(String decimalNumber): String
    -removeSignFromNegativeZero(String number): String
}

IllegalArgumentException <|-down- ChartDataException
ChartOptions .left.> ChartDataException : throws
Chart .up.> ChartDataException : throws

Chart -up-> "1" ChartOptions : options
Chart -right-> "1" PlotArea : plotArea
PlotArea -up-> "1" ChartOptions : options

Chart <|-down- BarChart
Chart <|-down- LineChart
Chart .down.> SvgElement : creates
Chart -down-> "1" LabelStyle : labelStyle
Chart .down.> ValueAxis : creates

ValueAxis -up-> "1" PlotArea : plotArea
ValueAxis -down-> "1" LabelStyle : labelStyle
ValueAxis .down.> SvgElement : creates
ValueAxis -down-> "1" LinearScale : scale
ValueAxis .down.> TickGenerator : creates

LinearScale -down-> "1" Interval : domain
LinearScale -down-> "1" Interval : pixels

LabelStyle .down.> SvgElement : creates
LineChart -down-> "1" NumberFormatter : numberFormatter

SvgElement --> "*" SvgElement : children
SvgElement -down-> "1" XmlEscaper : escaper
SvgElement -left-> "1" NumberFormatter : numberFormatter

@enduml
